# Binary (root only; do not hide cmd/searchmux source files)
/searchmux

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Config with secrets
config.yaml
!config.example.yaml
.env
.env.*
!.env.example
!.env.*.example

# OMO / Oh My OpenCode: local plans, drafts, evidence and session state.
# Keep shared rules and project initialization config versionable.
/.omo/*
!/.omo/rules/
!/.omo/rules/**
!/.omo/init-deep.json
/.sisyphus/*
!/.sisyphus/rules/
!/.sisyphus/rules/**

# Hermes: local runtime home and agent worktrees, not project skills.
# AGENTS.md, HERMES.md and .hermes.md intentionally remain versionable.
/.hermes/*
!/.hermes/skills/
!/.hermes/skills/**
/.worktrees/

# OpenCode: generated dependencies, not shared config/agents/commands/plugins.
/.opencode/node_modules/

# Test artifacts
coverage.out
*.test
